generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Subject {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  classes Class[]
}

model YearLevel {
  id       Int       @id @default(autoincrement())
  level    Int       @unique
  classes  Class[]
  students Student[]
}

model Room {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  classes Class[]
}

model Staff {
  id          Int            @id @default(autoincrement())
  name        String
  email       String         @unique
  phone       String?
  roles       String[]       @default(["tutor"])
  slackUserId String?        // cached Slack user id for DMs
  classes     Class[]
  sessions    ClassSession[]
  actions     StaffAction[]
  ownedLeads  Lead[]

  @@map("Tutor")
}

model StaffAction {
  id          Int      @id @default(autoincrement())
  staffId     Int
  staff       Staff    @relation(fields: [staffId], references: [id])
  type        String   // OS: "issue_resolved", "issue_note_added", "session_rescheduled", "session_staff_changed", "class_rescheduled", "student_note_updated", "term_initialised", "term_added"
                       // Non-OS: "booklet_work", "student_message", "online_class"
  automatic   Boolean  @default(true)  // true = OS-tracked, false = manually logged
  description String
  value       Float?   // for non-OS: hours or count
  metadata    Json?    // for OS: { issueId, sessionId, classId, studentId, etc. }
  createdAt   DateTime @default(now())
}

model Student {
  id          Int         @id @default(autoincrement())
  name        String
  lastName    String?
  email       String?
  phone       String?
  school      String?
  yearLevelId Int
  yearLevel   YearLevel   @relation(fields: [yearLevelId], references: [id])
  parentFirstName String?
  parentLastName  String?
  parentEmail     String?
  parentPhone     String?
  notes       String?
  archived    Boolean     @default(false)
  enrolments  Enrolment[]
  trials      TrialEnrolment[]
  issues      Issue[]
  invoices    Invoice[]
  attendances Attendance[]
  createdAt   DateTime    @default(now())
}

model Class {
  id              Int            @id @default(autoincrement())
  subjectId       Int
  subject         Subject        @relation(fields: [subjectId], references: [id])
  yearLevelId     Int
  yearLevel       YearLevel      @relation(fields: [yearLevelId], references: [id])
  staffId         Int            @map("tutorId")
  staff           Staff          @relation(fields: [staffId], references: [id])
  roomId          Int?
  room            Room?          @relation(fields: [roomId], references: [id])
  maxCapacity     Int
  isRecurring     Boolean
  dayOfWeek       Int?
  startTime       String?
  endTime         String?
  recurrenceStart DateTime?
  sessionDate     DateTime?
  archived        Boolean        @default(false)
  enrolments      Enrolment[]
  sessions        ClassSession[]
  createdAt       DateTime       @default(now())
}

model ClassSession {
  id        Int      @id @default(autoincrement())
  classId   Int
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  startTime String
  endTime   String
  cancelled    Boolean   @default(false)
  originalDate DateTime? @db.Date
  staffId      Int?      @map("tutorId")
  staff        Staff?    @relation(fields: [staffId], references: [id])
  attendances  Attendance[]
  trials       TrialEnrolment[]
  // 0 = no reminders sent, 1 = initial DM (at session start), 2 = +30min follow-up, 3 = +40min final
  attendanceReminderLevel Int @default(0)
  // Set when the first attendance modal submit fires parent emails. Subsequent submits skip emails.
  parentEmailsSentAt      DateTime?
}

model TrialEnrolment {
  id        Int          @id @default(autoincrement())
  studentId Int
  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId Int
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([studentId, sessionId])
  @@index([sessionId])
}

enum HomeworkStatus {
  UNATTEMPTED
  INCOMPLETE
  SATISFACTORY
  EXCELLENT
}

model Attendance {
  id        Int             @id @default(autoincrement())
  sessionId Int
  session   ClassSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  present         Boolean         @default(false)
  // When true AND present=false, the parent had already told us the student
  // wouldn't attend — we send an acknowledgement email instead of the
  // "we noticed X is missing" notice.
  notifiedAbsent  Boolean         @default(false)
  homework        HomeworkStatus?
  updatedAt       DateTime        @updatedAt

  @@unique([sessionId, studentId])
  @@index([sessionId])
}

model Enrolment {
  id         Int      @id @default(autoincrement())
  studentId  Int
  student    Student  @relation(fields: [studentId], references: [id])
  classId    Int
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([studentId, classId])
}

enum IssueType {
  FREE_TRIAL
  CANCELLATION
  RESCHEDULE
  ENQUIRY
}

enum IssuePriority {
  LOW
  MEDIUM
  URGENT
}

model Issue {
  id             Int           @id @default(autoincrement())
  type           IssueType
  priority       IssuePriority @default(MEDIUM)
  contactName    String
  studentId      Int?
  student        Student?      @relation(fields: [studentId], references: [id])
  assignedTo     String?
  note           String?
  resolutionNote String?
  resolved       Boolean       @default(false)
  source         String?       // "manual" | "gmail"
  rawEmail       String?       // raw snippet if sourced from email
  gmailMessageId String?       @unique // Gmail message ID for deduplication
  gmailThreadId  String?       // Gmail thread ID for chain grouping
  createdAt      DateTime      @default(now())
  notes          IssueNote[]

  @@index([gmailThreadId])
}

model IssueNote {
  id             Int      @id @default(autoincrement())
  issueId        Int
  issue          Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author         String
  content        String
  isEmail        Boolean  @default(false)
  gmailMessageId String?  @unique
  createdAt      DateTime @default(now())
}

model Invoice {
  id          Int               @id @default(autoincrement())
  studentId   Int
  student     Student           @relation(fields: [studentId], references: [id])
  year        Int?
  term        Int?
  subtotal    Float
  discount    Float             @default(0)
  total       Float
  status      InvoiceStatus     @default(DRAFT)
  sentAt      DateTime?
  paidAt      DateTime?
  createdAt   DateTime          @default(now())
  lineItems   InvoiceLineItem[]

  @@index([year, term])
}

model InvoiceLineItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  sessions    Int      // number of sessions being invoiced
  unitPrice   Float    // price per session
  amount      Float    // final amount (after pro-rata)
  proRata     Boolean  @default(false)
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

// ─── Lead Decay Tracking ────────────────────────────────────────────────────
// Separate pipeline for website contact-form / free-trial submissions.
// Ingested from admin@ Gmail (Sent folder, subject "Contact Us"). Fully
// independent from the Issue/IssueNote system.

enum LeadStage {
  NEW
  CONTACTED
  TRIAL_BOOKED
  TRIAL_ATTENDED
  ENROLLED
  CLOSED_LOST
  WAITLIST
}

model Lead {
  id             Int       @id @default(autoincrement())
  // When the form was submitted (from the Gmail notification's internalDate).
  createdAt      DateTime
  // When we ingested this record into the OS.
  ingestedAt     DateTime  @default(now())
  formType       String    // "trial" | "contact"
  parentName     String?
  studentName    String?
  email          String    // primary email used to match outbound/inbound events
  otherEmails    String[]  @default([])  // any extra emails found in the form body
  phone          String?
  yearLevel      Int?
  subjects       String?   // comma-separated
  message        String?   // the free-text message field, if present
  rawBody        String    // full plain-text body — for debugging + re-parse
  gmailMessageId String    @unique  // dedupe on notification email
  gmailThreadId  String?
  stage          LeadStage @default(NEW)
  ownerId        Int?
  owner          Staff?    @relation(fields: [ownerId], references: [id])
  closedReason   String?
  closedAt       DateTime?
  notes          String?
  events         LeadContactEvent[]

  @@index([email])
  @@index([stage])
  @@index([createdAt])
}

model LeadContactEvent {
  id             Int      @id @default(autoincrement())
  leadId         Int
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // When the event actually happened (Gmail internalDate for emails, entered
  // time for manual calls/SMS).
  timestamp      DateTime
  direction      String   // "inbound" | "outbound"
  channel        String   @default("email")  // email | phone | sms | in_person
  subject        String?
  snippet        String?  // plain-text preview
  fromAddress    String?
  toAddress      String?
  gmailMessageId String?  @unique
  loggedById     Int?     // set for manual calls; null for auto-ingested email
  createdAt      DateTime @default(now())

  @@index([leadId, timestamp])
}

model OAuthToken {
  id           Int       @id @default(autoincrement())
  provider     String    @unique
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  updatedAt    DateTime  @updatedAt
}
